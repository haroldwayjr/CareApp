{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "description": "Apply Bold xs batch 06 group g02", "skillNames": "figma-use,figma-generate-library", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' \u00b7 bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/misc/recycle\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Plastic-Bag-Recycle--Streamline-Ultimate\\\"> <g> <path d=\\\"m9.72 19.17 0.28 -0.49a2.25 2.25 0 0 1 0.9 -3.83l2.46 -0.69a2.19 2.19 0 0 1 0.23 -1.67l1.06 -1.85a3.19 3.19 0 0 1 1.14 -1.14 2.94 2.94 0 0 1 2.54 -0.22c0.08 -4 0.37 -7.46 0.87 -7.46 0.71 0 1 4.06 1 9.08a2.53 2.53 0 0 1 0.67 -0.1H21C21 0.06 20 0.05 19.39 0.05h-3.11a1.47 1.47 0 0 0 -1.44 1.12 21.05 21.05 0 0 0 -0.36 2.08H5.89c0.07 -0.58 0.13 -1.11 0.19 -1.5A1.48 1.48 0 0 0 4.62 0.05h-2a1.48 1.48 0 0 0 -1.49 1.16C0.12 5.92 0 12 0.63 20.82a1.5 1.5 0 0 0 1 1.3 30.39 30.39 0 0 0 8.52 1h0.33a3.09 3.09 0 0 1 -0.76 -3.95M5.78 4.75h8.49c-0.07 0.6 -0.14 1.18 -0.19 1.65a0.73 0.73 0 0 1 -0.73 0.64h-7a0.72 0.72 0 0 1 -0.55 -0.24 0.7 0.7 0 0 1 -0.18 -0.55c0 -0.42 0.08 -1 0.14 -1.51Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M15.2 14.26a0.74 0.74 0 0 0 1 -0.28l1.1 -1.87a0.11 0.11 0 0 1 0.14 0l0.89 1.55 -0.93 0.56a0.73 0.73 0 0 0 -0.36 0.75 0.75 0.75 0 0 0 0.55 0.62l2.48 0.63 0.14 0h0.07a0.61 0.61 0 0 0 0.3 -0.08 0.79 0.79 0 0 0 0.17 -0.14 0.58 0.58 0 0 0 0.13 -0.26l0.64 -2.48a0.75 0.75 0 0 0 -1.11 -0.83l-0.89 0.53 -0.88 -1.53a1.6 1.6 0 0 0 -2.18 -0.6 1.7 1.7 0 0 0 -0.6 0.59l-1.06 1.84a0.76 0.76 0 0 0 0.4 1\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M22.64 18.13a0.75 0.75 0 1 0 -1.3 0.75l1 1.84a0.11 0.11 0 0 1 -0.1 0.1h-1.89v-1.17a0.77 0.77 0 0 0 -0.48 -0.69 0.74 0.74 0 0 0 -0.81 0.18L17.26 21a0.78 0.78 0 0 0 -0.21 0.54 0.72 0.72 0 0 0 0.23 0.53l1.83 1.78a0.74 0.74 0 0 0 0.52 0.22 0.59 0.59 0 0 0 0.29 -0.07 0.74 0.74 0 0 0 0.46 -0.69v-0.95h1.91a1.61 1.61 0 0 0 1.39 -2.4Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"m11.18 17.67 0.88 0.5 -1 1.75a1.6 1.6 0 0