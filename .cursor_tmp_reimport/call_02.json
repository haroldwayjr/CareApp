{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "description": "Reimport Streamline Regular SVGs batch 02 stroke/corner fixes", "skillNames": "resource:figma-use", "code": "const page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\nfunction bindStrokes(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'LINE') {\n      const hasStroke = Array.isArray(n.strokes) && n.strokes.length > 0;\n      const hasFill = Array.isArray(n.fills) && n.fills.some(f => f.type === 'SOLID' && f.visible !== false);\n      if (hasStroke || (!hasFill && n.type === 'VECTOR')) {\n        n.fills = [];\n        n.strokes = [figma.variables.setBoundVariableForPaint(\n          { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault)];\n        n.strokeWeight = 1.5;\n        n.strokeJoin = 'ROUND';\n        n.strokeCap = 'ROUND';\n        try { n.strokeAlign = 'CENTER'; } catch (_) {}\n      }\n      if (hasFill && !hasStroke) {\n        n.fills = [figma.variables.setBoundVariableForPaint(\n          { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault)];\n      }\n    }\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nconst SIZE_PX = { sm: 20, md: 24, lg: 32 };\nfunction reimportRegular(set, svg) {\n  const results = {};\n  for (const [size, px] of Object.entries(SIZE_PX)) {\n    const variant = set.children.find(c => c.name === 'Size=' + size);\n    if (!variant) continue;\n    variant.visible = true;\n    for (const c of [...variant.children]) c.remove();\n    const node = figma.createNodeFromSvg(svg);\n    node.name = set.name.split('/').pop();\n    node.resize(px, px);\n    node.x = 0; node.y = 0;\n    node.clipsContent = false;\n    if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    variant.appendChild(node);\n    try { variant.resizeWithoutConstraints(px, px); } catch (_) { try { variant.resize(px, px); } catch(__){} }\n    bindStrokes(node);\n    variant.clipsContent = false;\n    results[size] = node.findAll(n => n.type==='VECTOR' || n.type==='ELLIPSE' || n.type==='LINE' || n.type==='BOOLEAN_OPERATION').length;\n  }\n  for (const c of set.children) c.visible = (c.name === 'Size=md');\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return results;\n}\n\nconst SVGS = {\"icon/health/blood\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Blood-Types-1--Streamline-Ultimate\\\">\\n  <desc>\\n    Blood Types 1 Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path stroke=\\\"#000000\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" d=\\\"M15.6071 15.8272c0 1.7827 -0.7583 3.4923 -2.1081 4.7529 -1.3498 1.2605 -3.1805 1.9687 -5.08937 1.9687 -1.90889 0 -3.73959 -0.7082 -5.08938 -1.9687 -1.34979 -1.2606 -2.10809 -2.9702 -2.10809 -4.7529 0 -5.7118 6.16465 -12.4334 7.19747 -12.4334s7.19747 6.7216 7.19747 12.4334Z\\\" stroke-width=\\\"1\\\"></path>\\n  <path stroke=\\\"#000000\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" d=\\\"M17.818 15.0102c1.4113 0 2.7647 -0.5235 3.7626 -1.4555 0.9979 -0.9319 1.5585 -2.1958 1.5585 -3.5138 0 -4.22274 -4.5575 -9.192023 -5.3211 -9.192023 -0.4686 0 -2.3664 1.871913 -3.7626 4.294243\\\" stroke-width=\\\"1\\\"></path>\\n  <path stroke=\\\"#000000\\\" stroke-