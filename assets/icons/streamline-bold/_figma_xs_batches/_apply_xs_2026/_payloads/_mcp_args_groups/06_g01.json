{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "description": "Apply Bold xs batch 06 group g01", "skillNames": "figma-use,figma-generate-library", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' \u00b7 bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/misc/printer.alt\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Printer-View--Streamline-Ultimate\\\"> <g> <path d=\\\"M6.5 5a1 1 0 0 0 1 -1V2.5A0.5 0.5 0 0 1 8 2h7.37a0.52 0.52 0 0 1 0.36 0.14l0.62 0.63a0.5 0.5 0 0 1 0.14 0.35V4a1 1 0 0 0 2 0V2.5a1 1 0 0 0 -0.29 -0.71L16.7 0.29A1 1 0 0 0 16 0H7a1.5 1.5 0 0 0 -1.5 1.5V4a1 1 0 0 0 1 1\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M12.19 21H8.5a1 1 0 0 1 -1 -1v-4a1 1 0 0 1 1 -1h4.69a0.25 0.25 0 0 0 0.2 -0.1 6.23 6.23 0 0 1 10.22 0 0.26 0.26 0 0 0 0.28 0.1 0.14 0.14 0 0 0 0.1 -0.14V9a2.5 2.5 0 0 0 -2.5 -2.5H2.5A2.5 2.5 0 0 0 0 9v6a2.5 2.5 0 0 0 2.5 2.5h2.75a0.25 0.25 0 0 1 0.25 0.25v3.75c0 0.86 0.82 1.5 1.92 1.5h4.83a1 1 0 0 0 0.8 -1.45 1 1 0 0 0 -0.86 -0.55M4.5 9.5a1 1 0 1 1 -1 -1 1 1 0 0 1 1 1\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M22.43 21a0.24 0.24 0 0 1 0 -0.3 4.39 4.39 0 0 0 0.6 -2.22 4.5 4.5 0 1 0 -4.5 4.5 4.39 4.39 0 0 0 2.22 -0.6 0.26 0.26 0 0 1 0.31 0l1.27 1.28a1 1 0 0 0 1.42 0 1 1 0 0 0 0 -1.42ZM16 18.49a2.5 2.5 0 1 1 2.5 2.5 2.5 2.5 0 0 1 -2.5 -2.5\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> </g> </svg>\"}, {\"setName\": \"icon/misc/projector\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Video-Projector--Streamline-Ultimate\\\"> <g> <path d=\\\"m9.34 9.94 7.2 -4a0.5 0.5 0 0 0 0 -0.88l-7.2 -4a0.5 0.5 0 0 0 -0.49 0 0.48 0.48 0 0 0 -0.25 0.43v8a0.48 0.48 0 0 0 0.25 0.43 0.55 0.55 0 0 0 0.49 0.02\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M5.5 10.5a1 1 0 0 0 -1 -1h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 1 -1\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M4 6a1 1 0 0 0 -1 -1H2a1 1 0 0 0 0 2h1a1 1 0 0 0 1 -1\\\" fill=\\\"#000000\\\" s