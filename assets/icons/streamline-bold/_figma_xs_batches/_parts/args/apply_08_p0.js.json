{"fileKey":"hB1NzwMnZt2ALeR0OslaWi","skillNames":"resource:figma-use","description":"Apply Streamline Bold xs apply_08_p0","code":"\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/files/file.image\",\"name\":\"file-image\",\"category\":\"files\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Common-File-Horizontal-Image--Streamline-Ultimate\\\">\\n  <desc>\\n    Common File Horizontal Image Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <g>\\n    <path d=\\\"M24 8.41a1 1 0 0 0 -0.29 -0.7l-5.42 -5.42a1 1 0 0 0 -0.7 -0.29H2a2 2 0 0 0 -2 2v16a2 2 0 0 0 2 2h20a2 2 0 0 0 2 -2ZM22 19.5a0.5 0.5 0 0 1 -0.5 0.5h-19a0.5 0.5 0 0 1 -0.5 -0.5v-15a0.5 0.5 0 0 1 0.5 -0.5H17a0.49 0.49 0 0 1 0.36 0.15l4.53 4.53A0.49 0.49 0 0 1 22 9Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M6.3 8a2 2 0 1 0 4 0 2 2 0 1 0 -4 0\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M13.72 10.68a0.49 0.49 0 0 0 -0.84 0l-2.43 3.88a0.27 0.27 0 0 1 -0.21 0.12 0.24 0.24 0 0 1 -0.21 -0.12l-0.87 -1.38a0.49 0.49 0 0 0 -0.42 -0.24 0.51 0.51 0 0 0 -0.43 0.24l-2.77 4.44a0.25 0.25 0 0 0 0 0.25 0.26 0.26 0 0 0 0.22 0.13h12.1a0.26 0.26 0 0 0 0.22 -0.13 0.25 0.25 0 0 0 0 -0.25Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n  </g>\\n</svg>\"},{\"setName\":\"icon/files/drawer\",\"name\":\"drawer\",\"category\":\"files\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Drawer-Open--Streamline-Ultimate\\\">\\n  <desc>\\n    Drawer Open Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path d=\\\"m23.88 11.26 -3.07 -5.5a2 2 0 0 0 -1.7 -1H4.9a2 2 0 0 0 -1.7 1l-3.07 5.5a1.4 1.4 0 0 0 -0.13 0.49v6a1.5 1.5 0 0 0 1.5 1.5h21a1.5 1.5 0 0 0 1.5 -1.5v-6a1.29 1.29 0 0 0 -0.12 -0.49m-19 -4.38a0.25 0.25 0 0 1 0.22 -0.13l13.86 0a0.25 0.25 0 0 1 0.22 0.13l2.24 4a0.25 0.25 0 0 1 0 0.25 0.27 0.27 0 0 1 -0.22 0.12h-3.7a1.5 1.5 0 0 0 -1.06 0.44 1.52 1.52 0 0 0 -0.44 1.06 1.5 1.5 0 0 1 -1.5 1.5h-5a1.5 1.5 0 0 1 -1.5 -1.5 1