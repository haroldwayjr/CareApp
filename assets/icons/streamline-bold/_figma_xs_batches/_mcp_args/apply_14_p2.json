{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "code": "\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/misc/satellite\",\"name\":\"satellite\",\"category\":\"misc\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Satellite--Streamline-Ultimate\\\">\\n  <desc>\\n    Satellite Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <g>\\n    <path d=\\\"M6.72 17.29A12 12 0 0 1 5.3 15.6L0.2 22.4a1 1 0 0 0 -0.09 1.05A1 1 0 0 0 1 24h11.5a1 1 0 0 0 0.89 -0.54 1 1 0 0 0 -0.07 -1l-1.39 -2a12.71 12.71 0 0 1 -5.21 -3.17\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M9.12 0.29A1 1 0 0 0 7.71 0.3a11.23 11.23 0 0 0 0.07 15.93 11.29 11.29 0 0 0 15.93 -0.08 1 1 0 0 0 0.29 -0.7 1 1 0 0 0 -0.3 -0.71l-6.56 -6.5 2.09 -2a3 3 0 0 0 4.27 -2.75 3 3 0 0 0 -3 -3 3 3 0 0 0 -2.68 4.3l-2.09 2Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n  </g>\\n</svg>\"},{\"setName\":\"icon/files/box.alt\",\"name\":\"box-alt\",\"category\":\"files\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Text-Box-2--Streamline-Ultimate\\\">\\n  <desc>\\n    Text Box 2 Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path fill=\\\"#000000\\\" fill-rule=\\\"evenodd\\\" d=\\\"M3.27577 0.560547C1.77619 0.560547 0.560547 1.77619 0.560547 3.27577c0 1.14629 0.710333 2.12668 1.714843 2.52499l0 12.39924c-1.00451 0.3983 -1.714843 1.3787 -1.714843 2.525 0 1.4996 1.215643 2.7152 2.715223 2.7152 1.14658 0 2.12717 -0.7107 2.52529 -1.7156H18.1997c0.3981 1.0049 1.3787 1.7156 2.5253 1.7156 1.4996 0 2.7152 -1.2156 2.7152 -2.7152 0 -1.1466 -0.7107 -2.1272 -1.7156 -2.5253V5.80106c1.0049 -0.39812 1.7156 -1.37871 1.7156 -2.52529 0 -1.49958 -1.2156 -2.715223 -2.7152 -2.715223 -1.1463 0 -2.1267 0.710333 -2.525 1.714843l-12.39924 0C5.40245 1.27088 4.42206 0.560547 3.27577 0.560547M18.1997 4.27539l-12.39864 0c-0.27555 0.69553 -0.83014 1.25012 -1.52567 1.52567l0 12.39864c0.69528 0.2754 1.24972 0.8297 1.52537 1.5249H18.2c0.2755 -0.6949 0.8297 -1