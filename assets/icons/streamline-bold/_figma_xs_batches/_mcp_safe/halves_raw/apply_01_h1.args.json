{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "code": "\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/actions/save\", \"name\": \"save\", \"category\": \"actions\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Floppy-Disk--Streamline-Ultimate\\\">\\n  <desc>\\n    Floppy Disk Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <g>\\n    <path d=\\\"M22 0H5.91A2 2 0 0 0 4.5 0.59L0.59 4.5A2 2 0 0 0 0 5.91V22a2 2 0 0 0 2 2h20a2 2 0 0 0 2 -2V2a2 2 0 0 0 -2 -2Zm-3.5 2a0.5 0.5 0 0 1 0.5 0.5v4A1.5 1.5 0 0 1 17.5 8h-10A1.5 1.5 0 0 1 6 6.5v-4a0.5 0.5 0 0 1 0.5 -0.5ZM5 22a0.5 0.5 0 0 1 -0.5 -0.5v-8A1.5 1.5 0 0 1 6 12h13a1.5 1.5 0 0 1 1.5 1.5v8a0.5 0.5 0 0 1 -0.5 0.5Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M15 4.25v1.5a0.75 0.75 0 0 0 1.5 0v-1.5a0.75 0.75 0 0 0 -1.5 0Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M7 16.25h6.5a0.75 0.75 0 0 0 0 -1.5H7a0.75 0.75 0 0 0 0 1.5Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M7 20.25h11a0.75 0.75 0 0 0 0 -1.5H7a0.75 0.75 0 0 0 0 1.5Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n  </g>\\n</svg>\"}, {\"setName\": \"icon/actions/copy\", \"name\": \"copy\", \"category\": \"actions\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\"><path fill=\\\"#000000\\\" fill-rule=\\\"evenodd\\\" d=\\\"M4.8039 18.7899c0 .5523-.44772 1-1 1H2.11816c-1.10456 0-1.999996-.8954-1.999996-2v-1.6857c0-.5523.447716-1 .999996-1 .55229 0 1 .4477 1 1v1.6857H3.8039c.55228 0 1 .4477 1 1Zm-3.68574-6.181c-.55228 0-.999996-.4477-.999996-1V8.23743c0-.55229.447716-1 .999996-1 .55229 0 1 .44771 1 1v3.37147c0 .5523-.44771 1-1 1Zm0-7.86677c-.55228 0-.999996-.44771-.999996-1V2.0564c0-1.10457.895426-2.0000035 1.999996-2.0000035H3.8039c.55229 0 1 .4477155 1 1.0000035 0 .55228-.44771 1-1 1l-1.68574 0v1.68573c0 .55229-.44771 1-1 1Zm17.73354 0c-.5523 0-1-.44771-1-1V2.0564H16.166c-.5523 0-1-.44772-1-1 0-.552288.4477-1.0000035 1-1.0000035h1.685