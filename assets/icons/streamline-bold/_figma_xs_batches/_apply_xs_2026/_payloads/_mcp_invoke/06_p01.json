{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "skillNames": "figma-use,figma-generate-library", "description": "Apply batch 06 pair p01 xs bold icons", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' · bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/misc/passport\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Passport--Streamline-Ultimate\\\"> <g> <path d=\\\"M8.3 13.5a0.49 0.49 0 0 0 0.5 -0.5 16.52 16.52 0 0 1 0.38 -2.62 0.48 0.48 0 0 0 -0.18 -0.5 0.5 0.5 0 0 0 -0.58 0 5.54 5.54 0 0 0 -2 3 0.5 0.5 0 0 0 0.09 0.44 0.49 0.49 0 0 0 0.39 0.19Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M14.7 13a0.5 0.5 0 0 0 0.5 0.47h1.39a0.49 0.49 0 0 0 0.39 -0.19 0.5 0.5 0 0 0 0.09 -0.44 5.54 5.54 0 0 0 -2 -3 0.5 0.5 0 0 0 -0.58 0 0.48 0.48 0 0 0 -0.21 0.53A16.52 16.52 0 0 1 14.7 13\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M11.39 8.81a9.77 9.77 0 0 0 -1.1 4.19 0.48 0.48 0 0 0 0.13 0.38 0.51 0.51 0 0 0 0.37 0.16h1.92a0.51 0.51 0 0 0 0.37 -0.16 0.48 0.48 0 0 0 0.13 -0.38 9.77 9.77 0 0 0 -1.1 -4.15 0.12 0.12 0 0 0 -0.11 -0.09h-0.58a0.12 0.12 0 0 0 -0.03 0.05\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M8.81 15.47a0.5 0.5 0 0 0 -0.5 -0.47h-1.4a0.49 0.49 0 0 0 -0.39 0.19 0.5 0.5 0 0 0 -0.09 0.44 5.5 5.5 0 0 0 2 3 0.5 0.5 0 0 0 0.58 0 0.51 0.51 0 0 0 0.21 -0.54 14.6 14.6 0 0 1 -0.41 -2.62\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M12.1 19.71a10.44 10.44 0 0 0 1.1 -4.17 0.45 0.45 0 0 0 -0.13 -0.38 0.48 0.48 0 0 0 -0.36 -0.16h-1.92a0.48 0.48 0 0 0 -0.36 0.16 0.45 0.45 0 0 0 -0.13 0.38 10.44 10.44 0 0 0 1.1 4.17l0.31 0 0.31 0Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M20.8 5.17a0.48 0.48 0 0 1 -0.3 -0.45V2a2 2 0 0 0 -2 -2h-13A3.5 3.5 0 0 0 2 3.5V21a3 3 0 0 0 3 3h15a2 2 0 0 0 2 -2V7a2 2 0 0 0 -1.2 -1.83M4 3.5A1.5 1.5 0 0 1 5.5 2H18a0.5 0.5 0 0 1 0.5 0.5v2a0.5 0.5 0 0 1 -0.5 0.5H5.5A1.5 1.5 0 0 1 4 3.5m7.75 17.75a7 7 0 1 1 7 -7 7 7 0 0 1 -7 7\\\" fill=\\\"#000000\\\" stroke-widt