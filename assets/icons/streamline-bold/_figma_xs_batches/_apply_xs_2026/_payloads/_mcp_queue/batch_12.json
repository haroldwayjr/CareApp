{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "skillNames": "figma-use,figma-generate-library", "description": "Apply batch 12 Size=xs Streamline Bold SVGs", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' \u00b7 bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/files/file.text\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Common-File-Text--Streamline-Ultimate\\\"> <path fill=\\\"#000000\\\" d=\\\"M14.25 6c0 0.59673 0.2372 1.16886 0.6592 1.59082 0.4219 0.42196 0.9941 0.65918 1.5908 0.65918h6v13c0 1.5188 -1.2312 2.75 -2.75 2.75H4.25c-1.51878 0 -2.75 -1.2312 -2.75 -2.75V2.75C1.5 1.23122 2.73122 0 4.25 0h10zM6.50098 18.75c-0.41422 0 -0.75 0.3358 -0.75 0.75 0 0.4141 0.33503 0.7497 0.74902 0.75h10.999c0.4142 0 0.751 -0.3358 0.751 -0.75 0 -0.414 -0.3361 -0.7497 -0.75 -0.75zm0 -4c-0.41422 0 -0.75 0.3358 -0.75 0.75 0 0.4141 0.33503 0.7497 0.74902 0.75h10.999c0.4142 0 0.751 -0.3358 0.751 -0.75 0 -0.414 -0.3361 -0.7497 -0.75 -0.75zm0 -4c-0.38819 0 -0.70848 0.2949 -0.74707 0.6729 -0.00259 0.0253 -0.00293 0.0511 -0.00293 0.0771s0.00034 0.0518 0.00293 0.0771c0.03858 0.3779 0.35813 0.6727 0.74609 0.6729h10.999c0.4142 0 0.751 -0.3358 0.751 -0.75 0 -0.414 -0.3361 -0.7497 -0.75 -0.75zm0 -4c-0.41422 0 -0.75 0.33579 -0.75 0.75s0.33578 0.75 0.75 0.75h4.78512c0.4138 -0.00053 0.75 -0.33611 0.75 -0.75s-0.3362 -0.74947 -0.75 -0.75zM15.8066 0.509766l0.1631 0.148437 5.8721 5.872067v0.00098c0.0685 0.06857 0.13 0.14278 0.1885 0.21875H16.5c-0.1989 0 -0.3896 -0.07907 -0.5303 -0.21973C15.8291 6.38962 15.75 6.19891 15.75 6V0.466797c0.0188 0.014433 0.0383 0.027935 0.0566 0.042969\\\" stroke-width=\\\"1\\\"></path> </svg>\"},{\"setName\":\"icon/files/database\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Database--Streamline-Ultimate\\\"> <g> <path d=\\\"M23 20.5h-1a0.75 0.75 0 0 0 0 1.5h1a0.75 0.75 0 0 0 0 -1.5\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M2 20.5H1A0.75 0.75 0 0 0 1 22h1a0.75 0.75 0 0 0 0 -1.5\\\" fill=\\\"#0000