{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "code": "\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/health/appointment\", \"name\": \"appointment\", \"category\": \"health\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Waiting-Room-Appointment-Medical-Appointment-2--Streamline-Ultimate\\\">\\n  <desc>\\n    Waiting Room Appointment Medical Appointment 2 Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path fill=\\\"#000000\\\" d=\\\"M17.5 0c0.2652 0 0.5195 0.105433 0.707 0.292969 0.1876 0.187536 0.293 0.441815 0.293 0.707031v1.5c0 0.13261 0.0527 0.25975 0.1465 0.35352C18.7403 2.94728 18.8674 3 19 3h3c0.5304 0 1.039 0.21086 1.4141 0.58594C23.7891 3.96101 24 4.46957 24 5v17c0 0.5304 -0.2109 1.039 -0.5859 1.4141C23.039 23.7891 22.5304 24 22 24H2c-0.53043 0 -1.03899 -0.2109 -1.414062 -0.5859C0.210865 23.039 0 22.5304 0 22V5c0 -0.53043 0.210865 -1.03899 0.585938 -1.41406C0.96101 3.21086 1.46957 3 2 3h2c0.13261 0 0.25975 0.05272 0.35352 0.14648 0.09376 0.09377 0.14648 0.22091 0.14648 0.35352v2.25c0 0.19891 0.07907 0.38962 0.21973 0.53027 0.14065 0.14066 0.33136 0.21973 0.53027 0.21973s0.38962 -0.07907 0.53027 -0.21973C5.92093 6.13962 6 5.94891 6 5.75V1c0 -0.265216 0.10543 -0.519495 0.29297 -0.707031C6.48051 0.105432 6.73478 0 7 0s0.51949 0.105432 0.70703 0.292969C7.89457 0.480505 8 0.734784 8 1v1.5c0 0.13261 0.05272 0.25975 0.14648 0.35352C8.24025 2.94728 8.36739 3 8.5 3h6c0.1326 0 0.2597 0.05272 0.3535 0.14648 0.0938 0.09377 0.1465 0.22091 0.1465 0.35352v2.25c0 0.19891 0.0791 0.38962 0.2197 0.53027 0.1407 0.14066 0.3314 0.21973 0.5303 0.21973s0.3896 -0.07907 0.5303 -0.21973c0.1406 -0.14065 0.2197 -0.33136 0.2197 -0.53027V1c0 -0.265216 0.1054 -0.519495 0.293 -0.707031C16.9805 0.105433 17.2348 0 17.5 0m-15 9c-0.13261 0 -0.25975 0.05272 -0.35352 0.14648C2.05272 9.24025 2 9.36739 2 9.5v12c0 0.1326 0.05272 0.2597 0.14648 0.3535 0.09377 0.0938 0.22091 0.1465 0.35352 0.1465h19c0.1326 0 0.2597 -0.0527 0.3535 -0.1465S22 21.6326 22 21.5v-12c0 -0.13261 -0.0