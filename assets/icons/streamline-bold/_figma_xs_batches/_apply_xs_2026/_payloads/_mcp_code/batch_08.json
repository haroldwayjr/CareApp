{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "description": "Apply Streamline Bold SVGs to Size=xs batch 08", "skillNames": "figma-use,figma-generate-library", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' \u00b7 bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/actions/archive\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Archive--Streamline-Ultimate\\\"> <g> <path d=\\\"M21.5 2.5h-19a2 2 0 0 0 -2 2v3a1 1 0 0 0 1 1h21a1 1 0 0 0 1 -1v-3a2 2 0 0 0 -2 -2Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M21.5 10h-19a1 1 0 0 0 -1 1v8.5a2 2 0 0 0 2 2h17a2 2 0 0 0 2 -2V11a1 1 0 0 0 -1 -1Zm-6.25 3.5A1.25 1.25 0 0 1 14 14.75h-4a1.25 1.25 0 0 1 0 -2.5h4a1.25 1.25 0 0 1 1.25 1.25Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> </g> </svg>\"},{\"setName\":\"icon/actions/attach\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Attachment--Streamline-Ultimate\\\"> <path d=\\\"M21.84 3.46a7 7 0 0 0 -9.84 0L1.62 13.83a5.13 5.13 0 0 0 7.25 7.25l8.43 -8.43A3.29 3.29 0 1 0 12.65 8l-5.19 5.18a1 1 0 0 0 0 1.42 1 1 0 0 0 1.41 0l5.19 -5.19a1.3 1.3 0 0 1 2.21 0.91 1.32 1.32 0 0 1 -0.38 0.92l-8.43 8.43a3.13 3.13 0 0 1 -5.34 -2.21A3.09 3.09 0 0 1 3 15.25L13.41 4.87a5 5 0 0 1 7 7l-7.78 7.78a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l7.78 -7.78a7 7 0 0 0 0 -9.84Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> </svg>\"},{\"setName\":\"icon/actions/browse\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"E-Commerce-Apparel-Browse--Streamline-Ultimate\\\"> <g> <path d=\\\"M16 16v-3.25a0.25 0.25 0 0 1 0.25 -0.25h1.25a0.49 0.49 0 0 0 0.39 -0.19 0.51 0.51 0 0 0 0.1 -0.43l-0.82 -3.24a1.49 1.49 0 0 0 -1.45 -1.14H13.5a0.5 0.5 0 0 0 -0.5 0.5 1 1 0 0 1 -2 0 0.5 0.5 0 0 0 -0.5 -0.5H8.28a1.49 1.49 0 0 0 -1.45 1.14L6 11.88a0.51 0.51 0 0 0 0.1 0.43 0.49 0.49 0 0 0 0.39 0.19h1.26a0.25 0.25 0 0 1 0.25 0.25V16a0.5 0.5 0 0 0 0.5 0.5h7a0.5 0.5 0 0 0 0.5 -0.5\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <