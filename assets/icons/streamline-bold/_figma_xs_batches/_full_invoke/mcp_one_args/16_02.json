{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "skillNames": "resource:figma-use", "description": "Reapply Streamline Bold Size=xs batch 16 icon 02", "code": "\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch(__){} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false;\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\nconst BATCH = [{\"setName\": \"icon/files/policy\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\">\\n  <path fill=\\\"#000000\\\" d=\\\"M19.415 19.3613c0.1722 0.1032 0.3332 0.2267 0.4776 0.3711 0.4688 0.4689 0.7324 1.1046 0.7324 1.7676s-0.2636 1.2987 -0.7324 1.7676c-0.4689 0.4688 -1.1046 0.7324 -1.7676 0.7324H8.57715c0.30324 -0.4868 0.50924 -1.0554 0.60937 -1.6523 0.13746 -0.8204 0.07552 -1.6846 -0.18164 -2.46 -0.06013 -0.1812 -0.1327 -0.3572 -0.21386 -0.5264zM15.0654 1.625c-0.6682 1.2295 -1.8645 2.14202 -3.2519 2.41602 -0.7981 0.15783 -1.3982 0.71748 -1.6612 1.40039 -0.0318 0.08261 -0.0595 0.16885 -0.082 0.25781l-0.001 0.0039c-0.0044 0.01682 -0.0164 0.06187 -0.0273 0.11817 -0.0036 0.01872 -0.0069 0.0378 -0.0098 0.05664l-0.0117 0.07617 -0.0107 0.08887c-0.0028 0.02956 -0.0038 0.05624 -0.0049 0.07812 -0.0006 0.00699 -0.0015 0.01479 -0.002 0.02246L10 6.23145v0.02636c0 0.05535 0.0027 0.11101 0.0088 0.16602l0.0146 0.13183c0.0042 0.0373 0.0097 0.07446 0.0166 0.11133 0.0111 0.05879 0.0243 0.10965 0.0264 0.11817l0.001 0.0039c0.0126 0.0512 0.0267 0.09909 0.041 0.14356l0.043 0.12304c0.2619 0.68293 0.8616 1.24501 1.6621 1.40332 1.8473 0.36483 3.3567 1.86122 3.7304 3.73142l0.0469 0.1934C15.8689 13.3327 16.7428 14 17.75 14h0.001c0.3568 -0.0002 0.6962 -0.0857 0.999 -0.2363v4.0976H7.24805c-0.32663 0.0002 -0.616 0.2121 -0.71485 0.5235 -0.09826 0.3111 0.01564 0.6506 0.28223 0.8388 0.30081 0.2125 0.58687 0.598 0.76562 1.1368 0.17752 0.5353 0.22444 1.1515 0.12598 1.7392 -0.09894 0.5896 -0.33166 1.079 -0.62305 1.4043 -0.28522 0.3181 -0.58881 0.4428 -0.85058 0.4453 -0.53695 -0.1028 -1.03557 -0.3627 -1.42774 -0.7549C4.28994 22.6786 4 21.9793 4 21.25V5c0 -0.41421 -0.33579 -0.75 -0.75 -0.75s-0.75 0.33579 -0.75 0.75v3.375H0.75c-0.414214 0 -0.75 -0.33579 -0.75 -0.75v-3.25c0 -0.72935 0.289939 -1.42861 0.8056