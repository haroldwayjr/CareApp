{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "skillNames": "figma-use,figma-generate-library", "description": "Apply batch 06 pair p06 xs bold icons", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' \u00b7 bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/misc/scanner\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Scanner--Streamline-Ultimate\\\"> <g> <path d=\\\"M0.33 20a0.25 0.25 0 0 0 -0.19 0.09 0.28 0.28 0 0 0 -0.05 0.2C0.46 22.59 2.45 24 5.5 24h13c3.05 0 5 -1.41 5.41 -3.71a0.28 0.28 0 0 0 -0.05 -0.2 0.25 0.25 0 0 0 -0.19 -0.09Zm19.17 1a0.75 0.75 0 1 1 -0.75 0.75 0.76 0.76 0 0 1 0.75 -0.75m-3 0a0.75 0.75 0 1 1 -0.75 0.75 0.76 0.76 0 0 1 0.75 -0.75\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M4 9.75a0.25 0.25 0 0 0 -0.23 0.16L0.3 18.66a0.27 0.27 0 0 0 0 0.23 0.26 0.26 0 0 0 0.23 0.11h22.94a0.26 0.26 0 0 0 0.21 -0.11 0.27 0.27 0 0 0 0 -0.23L20.2 9.91a0.25 0.25 0 0 0 -0.2 -0.16Zm15.88 7.53a0.48 0.48 0 0 1 -0.41 0.22H4.5a0.48 0.48 0 0 1 -0.41 -0.22 0.45 0.45 0 0 1 0 -0.46l2 -5a0.48 0.48 0 0 1 0.46 -0.32h11a0.48 0.48 0 0 1 0.46 0.32l2 5a0.45 0.45 0 0 1 -0.1 0.46Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M20.09 8.25a0.24 0.24 0 0 0 0.24 -0.2L22 0.61a0.49 0.49 0 0 0 -0.1 -0.42 0.51 0.51 0 0 0 -0.4 -0.19h-19a0.51 0.51 0 0 0 -0.39 0.19 0.49 0.49 0 0 0 -0.11 0.42l1.67 7.44a0.24 0.24 0 0 0 0.24 0.2Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> </g> </svg>\"}, {\"setName\": \"icon/misc/schedule\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Scheduled-Phone-Call-Calendar-2--Streamline-Ultimate\\\"> <path fill=\\\"#000000\\\" d=\\\"M19.5 12c0.3315 0 0.6494 0.1318 0.8838 0.3662s0.3662 0.5523 0.3662 0.8838v2h2c0.3315 0 0.6494 0.1318 0.8838 0.3662S24 16.1685 24 16.5v3c0 0.3315 -0.1318 0.6494 -0.3662 0.8838s-0.5523 0.3662 -0.8838 0.3662h-2v2c0 0.3315 -0.1318 0.6494 -0.3662 0.8838S19.8315 24 19.5 24h-3c-0.3315 0 -0.6494 -0.1318 -0.8838 -0.3662s-0.3662 -0.5523 -0.3662 -