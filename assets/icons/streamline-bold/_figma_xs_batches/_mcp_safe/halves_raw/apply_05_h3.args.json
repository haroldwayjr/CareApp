" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M21 14a1 1 0 1 0 -1 1.75c1.26 0.7 2 1.54 2 2.3 0 1.89 -4.28 4 -10 4S2 19.89 2 18c0 -1.41 2.5 -3.22 7.13 -3.82a1 1 0 0 0 -0.26 -2C3.48 12.89 0 15.17 0 18c0 3.42 5.16 6 12 6s12 -2.58 12 -6c0 -1.54 -1.07 -3 -3 -4\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M5 17.97a1.5 1.5 0 1 0 3 0 1.5 1.5 0 1 0 -3 0\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M14.25 19.47a1.25 1.25 0 1 0 2.5 0 1.25 1.25 0 1 0 -2.5 0\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M18 17.97a1 1 0 1 0 2 0 1 1 0 1 0 -2 0\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n  </g>\\n</svg>\"}];\nlet ok = 0, missing = 0, failed = 0;\nconst miss = [], fail = [];\nfor (const item of BATCH) {\n  const set = page.findOne(n => n.type === 'COMPONENT_SET' && n.name === item.setName);\n  if (!set) { missing++; if (miss.length < 5) miss.push(item.setName); continue; }\n  try {\n    const r = applyBoldXs(set, item.svg);\n    if (r.ok) ok++; else { failed++; fail.push({ name: item.setName, r }); }\n  } catch (e) {\n    failed++;\n    if (fail.length < 5) fail.push({ name: item.setName, err: String(e) });\n  }\n}\nreturn { ok, missing, failed, miss, fail };\n", "description": "Apply Streamline Bold SVGs to Size=xs (apply_05_h3)", "skillNames": "resource:figma-use"}