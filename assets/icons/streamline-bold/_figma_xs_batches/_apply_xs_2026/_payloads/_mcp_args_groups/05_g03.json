{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "description": "Apply Bold xs batch 05 group g03", "skillNames": "figma-use,figma-generate-library", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' \u00b7 bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/misc/layout\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Layout-Dashboard--Streamline-Ultimate\\\"> <path fill=\\\"#000000\\\" fill-rule=\\\"evenodd\\\" d=\\\"M14.748 -0.000244141c-0.9665 0 -1.75 0.783501141 -1.75 1.750004141v4.5c0 0.96649 0.7835 1.75 1.75 1.75h7.5c0.9665 0 1.75 -0.78351 1.75 -1.75v-4.5c0 -0.966503 -0.7835 -1.750004141 -1.75 -1.750004141zM14.748 10c-0.9665 0 -1.75 0.7835 -1.75 1.75v10.5002c0 0.9665 0.7835 1.75 1.75 1.75h7.5c0.9665 0 1.75 -0.7835 1.75 -1.75V11.75c0 -0.9665 -0.7835 -1.75 -1.75 -1.75zM0.00195312 1.75C0.00195312 0.783502 0.785455 0 1.75195 0h7.5C10.2185 0 11.002 0.783501 11.002 1.75v10.5002c0 0.9665 -0.7835 1.75 -1.75005 1.75h-7.5c-0.966495 0 -1.74999688 -0.7835 -1.74999688 -1.75zM1.75195 15.9998c-0.966495 0 -1.74999688 0.7835 -1.74999688 1.75v4.5c0 0.9665 0.78350188 1.75 1.74999688 1.75h7.5c0.96655 0 1.75005 -0.7835 1.75005 -1.75v-4.5c0 -0.9665 -0.7835 -1.75 -1.75005 -1.75z\\\" clip-rule=\\\"evenodd\\\" stroke-width=\\\"1\\\"></path> </svg>\"}, {\"setName\": \"icon/misc/leaf\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Vegetable-Basil-Leaf--Streamline-Ultimate\\\"> <g> <path d=\\\"M12.65 18.32a4.87 4.87 0 0 1 -0.36 -0.59 5.18 5.18 0 0 1 -0.29 -3.52c0 -0.07 -0.11 -0.14 -0.16 -0.22l-0.58 0c-0.63 0.56 -1.26 1.07 -1.87 1.52a14.6 14.6 0 0 0 -0.71 3.23 0.74 0.74 0 0 1 -0.75 0.73 0.75 0.75 0 0 1 -0.74 -0.76 10.63 10.63 0 0 1 0.3 -2 13.61 13.61 0 0 1 -3.09 1.32 0.75 0.75 0 0 1 -0.93 -0.52 0.74 0.74 0 0 1 0.52 -0.92 15.13 15.13 0 0 0 5.22 -2.86 5.58 5.58 0 0 1 -2.74 -1.53 5.29 5.29 0 0 1 -0.55 -0.7 6.27 6.27 0 0 0 -2.41 1.58C-1 17.65 0.34 23.18 0.69 23.53A6 6 0 0 0 3.4 24a10.71 10.71 0 0 0 7.66 -3.24 6.32 6.32 0 0 0 1.59 -2.44\\\" fill=\\\"#00