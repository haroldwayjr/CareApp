{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "description": "Apply Streamline Bold SVGs to Size=xs batch 09", "skillNames": "figma-use,figma-generate-library", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' \u00b7 bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/actions/edit\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\"><g><path d=\\\"M16.19 3.51a.51.51 0 0 0-.71 0L4.07 14.92a.5.5 0 0 0 0 .71l4.28 4.28a.48.48 0 0 0 .7 0L20.47 8.5a.51.51 0 0 0 0-.71Z\\\" fill=\\\"#000000\\\"/><path d=\\\"M3 16.71a.51.51 0 0 0-.47-.13.48.48 0 0 0-.36.33L0 23.33a.49.49 0 0 0 .12.51.5.5 0 0 0 .54.16l6.42-2.14a.52.52 0 0 0 .33-.36.49.49 0 0 0-.14-.5Z\\\" fill=\\\"#000000\\\"/><path d=\\\"M23 1a3.6 3.6 0 0 0-5 0l-.71.71a.5.5 0 0 0 0 .71l4.28 4.28a.51.51 0 0 0 .7 0L23 6a3.53 3.53 0 0 0 0-5Z\\\" fill=\\\"#000000\\\"/></g></svg>\"},{\"setName\":\"icon/actions/empty.trash\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Bin-1--Streamline-Ultimate\\\"> <g> <path d=\\\"M19.45 7.5H4.55a0.5 0.5 0 0 0 -0.5 0.54l1.28 14.14a2 2 0 0 0 2 1.82h9.34a2 2 0 0 0 2 -1.82L20 8a0.5 0.5 0 0 0 -0.5 -0.54Zm-9.2 13a0.75 0.75 0 0 1 -1.5 0v-9a0.75 0.75 0 0 1 1.5 0Zm5 0a0.75 0.75 0 0 1 -1.5 0v-9a0.75 0.75 0 0 1 1.5 0Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M22 4h-4.75a0.25 0.25 0 0 1 -0.25 -0.25V2.5A2.5 2.5 0 0 0 14.5 0h-5A2.5 2.5 0 0 0 7 2.5v1.25a0.25 0.25 0 0 1 -0.25 0.25H2a1 1 0 0 0 0 2h20a1 1 0 0 0 0 -2ZM9 3.75V2.5a0.5 0.5 0 0 1 0.5 -0.5h5a0.5 0.5 0 0 1 0.5 0.5v1.25a0.25 0.25 0 0 1 -0.25 0.25h-5.5A0.25 0.25 0 0 1 9 3.75Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> </g> </svg>\"},{\"setName\":\"icon/actions/flag.alt\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Flag--Streamline-Ultimate\\\"> <g> <path d=\\\"m23.56 15.61 -6.77 -5.41a0.27 0.27 0 0 1 0 -0.4l6 -4.78c0.52 -0.42 0.49 -0.81 0.42 -1s-0.28 -0.52 -0.95 -0.52h-9.5V2A1.5 1.5 0 0 0 11.25 0.5h-6a0.5 0.5 0 0 0 -0.5 0.5v12a0.5 0.5 0 0 0 0.5 0.5h4.23a3.54 