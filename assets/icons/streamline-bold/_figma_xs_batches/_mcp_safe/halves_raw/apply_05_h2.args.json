{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "code": "\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/health/vaccine\", \"name\": \"vaccine\", \"category\": \"health\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Vaccine-Bottle-1--Streamline-Ultimate\\\">\\n  <desc>\\n    Vaccine Bottle 1 Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path fill=\\\"#000000\\\" fill-rule=\\\"evenodd\\\" d=\\\"M16.6497 2.93829v3.38493h-0.2667c-0.3736 -0.00021 -0.7435 0.07321 -1.0887 0.21607 -0.3451 0.14285 -0.6587 0.35233 -0.9228 0.61647 -0.2642 0.26414 -0.4737 0.57775 -0.6165 0.9229 -0.1429 0.34515 -0.2163 0.71507 -0.2161 1.08861l0.0805 8.11493h-1.1726c-0.5523 0 -1 0.4477 -1 1s0.4477 1 1 1h4.2023v2.1979h-2.0139c-0.5523 0 -1 0.4477 -1 1s0.4477 1 1 1h6.0298c0.5523 0 1 -0.4477 1 -1s-0.4477 -1 -1 -1h-2.0159v-2.1979h4.2029c0.5523 0 1 -0.4477 1 -1s-0.4477 -1 -1 -1h-1.173l0.0228 -2.3008h-2.4601c-0.4142 0 -0.75 -0.3357 -0.75 -0.75 0 -0.4142 0.3358 -0.75 0.75 -0.75h2.475l0.0233 -2.3452h-2.4983c-0.4142 0 -0.75 -0.3358 -0.75 -0.75 0 -0.41418 0.3358 -0.74997 0.75 -0.74997h2.5132l0.0046 -0.46896c0.0002 -0.37354 -0.0732 -0.74346 -0.216 -1.08862 -0.1429 -0.34515 -0.3524 -0.65875 -0.6165 -0.92289s-0.5777 -0.47362 -0.9229 -0.61647c-0.3451 -0.14286 -0.7151 -0.21628 -1.0886 -0.21607h-0.2658V2.93829c0 -0.55228 -0.4477 -1 -1 -1 -0.5522 0 -1 0.44772 -1 1M1.86182 6.81873c-0.55229 0 -1.000004 0.44771 -1.000004 1 0 0.55228 0.447714 1 1.000004 1h0.50634v1.14598h5.56598V8.81873h0.50358c0.55228 0 1 -0.44772 1 -1 0 -0.55229 -0.44772 -1 -1 -1zM0.419922 13.8462c0 -1.3591 1.101748 -2.4608 2.460828 -2.4608h4.53782c1.35908 0 2.46082 1.1017 2.46082 2.4608v7.0226c0 1.3591 -1.10174 2.4608 -2.46082 2.4608H2.88075c-1.35908 0 -2.460828 -1.1017 -2.460828 -2.4608v-0.0181H3.81772c0.41422 0 0.75 -0.3358 0.75 -0.75v-5.4861c0 -0.4142 -0.33578 -0.75 -0.75 -0.75H0.419922zm0 1.5184v3.9861H3.06772v-3.9861z\\\" clip-rule=\\\"evenodd\\\" stroke-width=\\\"1\\\"></path>\\n</svg>\"}, {\"setName\": \"icon/health/v