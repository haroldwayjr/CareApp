{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "skillNames": "figma-use,figma-generate-library", "description": "Apply Streamline Ultimate Bold SVGs batch 01 to Size=xs", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' \u00b7 bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/health/fitness\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Fitness-Weights--Streamline-Ultimate\\\"> <g> <path d=\\\"M2 7.5H1a1 1 0 0 0 -1 1v7a1 1 0 0 0 1 1h1a0.5 0.5 0 0 0 0.5 -0.5V8a0.5 0.5 0 0 0 -0.5 -0.5\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M7 5.5H4.5a1 1 0 0 0 -1 1v11a1 1 0 0 0 1 1H7a0.5 0.5 0 0 0 0.5 -0.5V6a0.5 0.5 0 0 0 -0.5 -0.5\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M23 7.5h-1a0.5 0.5 0 0 0 -0.5 0.5v8a0.5 0.5 0 0 0 0.5 0.5h1a1 1 0 0 0 1 -1v-7a1 1 0 0 0 -1 -1\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M19.5 5.5H17a0.5 0.5 0 0 0 -0.5 0.5v12a0.5 0.5 0 0 0 0.5 0.5h2.5a1 1 0 0 0 1 -1v-11a1 1 0 0 0 -1 -1\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M9 10.5h6s0.5 0 0.5 0.5v2s0 0.5 -0.5 0.5H9s-0.5 0 -0.5 -0.5v-2s0 -0.5 0.5 -0.5\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> </g> </svg>\"},{\"setName\":\"icon/health/glasses\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Glasses--Streamline-Ultimate\\\"> <path d=\\\"M20.61 1.43a1 1 0 0 0 0 2A1.4 1.4 0 0 1 22 4.83v7.9a0.25 0.25 0 0 1 -0.09 0.2 0.27 0.27 0 0 1 -0.21 0.05 3.08 3.08 0 0 0 -0.61 -0.07H16.3a2.92 2.92 0 0 0 -2.16 1 0.25 0.25 0 0 1 -0.32 0 3.39 3.39 0 0 0 -3.64 0 0.25 0.25 0 0 1 -0.32 0 2.92 2.92 0 0 0 -2.16 -1H2.91a3.08 3.08 0 0 0 -0.61 0.09 0.27 0.27 0 0 1 -0.21 -0.05 0.25 0.25 0 0 1 -0.09 -0.2V4.83a1.4 1.4 0 0 1 1.39 -1.4 1 1 0 0 0 0 -2A3.4 3.4 0 0 0 0 4.83v14.82a2.92 2.92 0 0 0 2.91 2.92H7.7a2.92 2.92 0 0 0 2.91 -2.92v-2.87a1.39 1.39 0 0 1 2.78 0v2.87a2.92 2.92 0 0 0 2.91 2.92h4.79A2.92 2.92 0 0 0 24 19.65V4.83a3.4 3.4 0 0 0 -3.39 -3.4m-12 18.22a0.92 0.92 0 0 1 -0.91 0.92H2.91a0.92 0.92 0 