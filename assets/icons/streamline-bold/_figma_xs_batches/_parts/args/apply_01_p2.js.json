{"fileKey":"hB1NzwMnZt2ALeR0OslaWi","skillNames":"resource:figma-use","description":"Apply Streamline Bold xs apply_01_p2","code":"\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/navigation/split\",\"name\":\"split\",\"category\":\"navigation\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Split-Subset-Spreadsheet-2--Streamline-Ultimate\\\">\\n  <desc>\\n    Split Subset Spreadsheet 2 Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path fill=\\\"#000000\\\" fill-rule=\\\"evenodd\\\" d=\\\"m8.40917 8.86846 -0.02232 0.00025H1.16054c-0.552287 0 -1.000002 -0.44772 -1.000002 -1V3.08766c0 -1.61214 1.314872 -2.927015 2.927012 -2.927015h5.27698L8.38685 0.1604H20.9124c1.6122 0 2.9271 1.31487 2.9271 2.92702l0 1.42698 0 3.35406c0 0.55229 -0.4478 1 -1 1zM21.8395 3.08742v0.42698h-5.2263v-1.354h4.2992c0.5076 0 0.9271 0.41944 0.9271 0.92702m0 2.42698h-5.2263v1.35406h5.2263zm-7.2263 1.35406V5.51465H9.38685v1.35381zm0 -3.35381V2.1604H9.38685v1.35425zM3.08755 2.16064c-0.50757 0 -0.92701 0.41945 -0.92701 0.92702v0.42674h5.22631V2.16064zm4.2993 4.70807V5.5144H2.16054v1.35431zM1.16054 18.467c-0.552287 0 -1.000002 0.4478 -1.000002 1v1.4453c0 1.6121 1.314872 2.927 2.927012 2.927H20.9124c1.6122 0 2.9271 -1.3149 2.9271 -2.927V19.467c0 -0.5522 -0.4478 -1 -1 -1zm15.45266 2v1.3723h4.2992c0.5076 0 0.9271 -0.4194 0.9271 -0.927v-0.4453zm-2 0H9.38685v1.3723h5.22635zm-12.45266 0.4453v-0.4453h5.22631v1.3723h-4.2993c-0.50757 0 -0.92701 -0.4194 -0.92701 -0.927M6.14156 9.77736c-0.24395 0.0014 -0.4672 0.09015 -0.64006 0.23654l-1.36799 1.14c-0.32344 0.2695 -0.44341 0.7128 -0.30009 1.1086 0.14333 0.3959 0.51925 0.6596 0.94027 0.6596h0.37373v1.4915h-0.37373c-0.42102 0 -0.79695 0.2637 -0.94027 0.6595 -0.14333 0.3959 -0.02335 0.8392 0.30009 1.1087l1.36573 1.1381c0.17456 0.1487 0.40088 0.2385 0.64818 0.2385 0.24706 0 0.4732 -0.0896 0.64769 -0.2381l1.36622 -1.1385c0.32344 -0.2695 0.44342 -0.7128 0.30009 -1.1087 -0.14332 -0.3958 -0.51925 -0.6595 -0.94027 -0.6595h-0.37373v-1.4915h0.373