{"fileKey":"hB1NzwMnZt2ALeR0OslaWi","skillNames":"resource:figma-use","description":"Apply Streamline Bold xs apply_08_p2","code":"\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/commerce/payment\",\"name\":\"payment\",\"category\":\"commerce\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Credit-Card-Payment--Streamline-Ultimate\\\">\\n  <desc>\\n    Credit Card Payment Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <g>\\n    <path d=\\\"M3.93 5.6a1 1 0 0 0 1 -1V3.05A0.24 0.24 0 0 1 5 2.84a0.25 0.25 0 0 1 0.25 0l0.18 0.09a1 1 0 0 0 1 -0.06l0.78 -0.53a0.28 0.28 0 0 1 0.28 0l0.79 0.53a1 1 0 0 0 1 0.06l0.18 -0.09a0.23 0.23 0 0 1 0.24 0 0.24 0.24 0 0 1 0.12 0.21v1.57a1 1 0 1 0 2 0V1.85A1.47 1.47 0 0 0 9.63 0.54L9 0.85a0.25 0.25 0 0 1 -0.25 0L8.16 0.43a1.45 1.45 0 0 0 -1.62 0l-0.61 0.4a0.25 0.25 0 0 1 -0.25 0L5.07 0.54A1.47 1.47 0 0 0 3 1.85v2.77a1 1 0 0 0 0.93 0.98\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M22.5 2.29h-3.64a0.25 0.25 0 0 0 -0.25 0.25V12.8a0.25 0.25 0 0 0 0.25 0.25h3.64a1 1 0 0 0 1 -1V3.29a1 1 0 0 0 -1 -1M22 5.71a0.49 0.49 0 0 1 -1 0V4.24a0.49 0.49 0 0 1 1 0Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M17.63 2.54a0.25 0.25 0 0 0 -0.25 -0.25h-0.71a1 1 0 0 0 -1 1v8.76a1 1 0 0 0 1 1h0.71a0.25 0.25 0 0 0 0.25 -0.25Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M21.54 19.41h-0.73a0.25 0.25 0 0 1 -0.25 -0.25V16a1 1 0 1 0 -1.95 0v3.17a0.25 0.25 0 0 1 -0.25 0.25h-0.73a0.5 0.5 0 0 0 -0.35 0.84l2 2a0.5 0.5 0 0 0 0.35 0.14 0.49 0.49 0 0 0 0.34 -0.14l2 -2a0.5 0.5 0 0 0 -0.35 -0.84Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M11.27 6.33H3.44A2.94 2.94 0 0 0 0.5 9.27v11.61a2.87 2.87 0 0 0 2.79 2.94h8.13a2.87 2.87 0 0 0 2.78 -2.94V9.27a2.94 2.94 0 0 0 -2.93 -2.94m0.49 14h-1a0.74 0.74 0 1 1 0 -1.47h1a0.74 0.74 0 0 1 0 1.47m-3.92 -3.48h-1a0.73 0.73 0 1 1 0 -1.46h1a0.73 0.73 0 1 1 0 1.46m0.73 2.7a0.73 0.73 0 0 1 -0.73 0.73h-1a0.74 0.74 0 0 1 