{"fileKey":"hB1NzwMnZt2ALeR0OslaWi","skillNames":"resource:figma-use","description":"Apply Streamline Bold xs apply_03_p2","code":"\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/media/equalizer\",\"name\":\"equalizer\",\"category\":\"media\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Equalizer-1--Streamline-Ultimate\\\">\\n  <desc>\\n    Equalizer 1 Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path d=\\\"M24 2A1.5 1.5 0 0 0 22.5 0.5h-21A1.5 1.5 0 0 0 0 2v20a1.5 1.5 0 0 0 1.5 1.5h21A1.5 1.5 0 0 0 24 22Zm-6 16.5a1 1 0 0 1 0 -2h0.5a0.25 0.25 0 0 0 0.25 -0.25V9a0.75 0.75 0 0 1 1.5 0v7.25a0.25 0.25 0 0 0 0.25 0.25h0.5a1 1 0 0 1 0 2h-0.5a0.25 0.25 0 0 0 -0.25 0.25V21a0.75 0.75 0 0 1 -1.5 0v-2.25a0.25 0.25 0 0 0 -0.25 -0.25Zm-7.5 -4a1 1 0 0 1 0 -2h0.5a0.25 0.25 0 0 0 0.25 -0.25V9a0.75 0.75 0 0 1 1.5 0v3.25a0.25 0.25 0 0 0 0.25 0.25h0.5a1 1 0 0 1 0 2H13a0.25 0.25 0 0 0 -0.25 0.25V21a0.75 0.75 0 0 1 -1.5 0v-6.25a0.25 0.25 0 0 0 -0.25 -0.25ZM3.5 5a1 1 0 0 1 0 -2h17a1 1 0 0 1 0 2ZM3 18.5a1 1 0 0 1 0 -2h0.5a0.25 0.25 0 0 0 0.25 -0.25V9a0.75 0.75 0 0 1 1.5 0v7.25a0.25 0.25 0 0 0 0.25 0.25H6a1 1 0 0 1 0 2h-0.5a0.25 0.25 0 0 0 -0.25 0.25V21a0.75 0.75 0 0 1 -1.5 0v-2.25a0.25 0.25 0 0 0 -0.25 -0.25Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n</svg>\"},{\"setName\":\"icon/media/playlist\",\"name\":\"playlist\",\"category\":\"media\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Playlist--Streamline-Ultimate\\\">\\n  <desc>\\n    Playlist Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <g>\\n    <path d=\\\"M18 2H6a2 2 0 0 0 -2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2V4a2 2 0 0 0 -2 -2m-3.54 7 -3.41 1.1c-0.21 0 -0.3 0.15 -0.3 0.27v4.92A1.75 1.75 0 1 1 9 13.5h0.15a0.11 0.11 0 0 0 0.07 0 0.09 0.09 0 0 0 0 -0.07v-3.1a1.75 1.75 0 0 1 1.43 -1.72l3.41 -1.1a1.74 1.74 0 0 1 2.19 1.69v4.05a1.75 1.75 0 1 1 -1.75 -1.75 0.24 0.24 0 0 0 0.25 -0.25V9.2a0.25 0.25 0 0 0 -0.29 -0.2\\\" fill=\\\"#000000\\\" stroke-width=\\\