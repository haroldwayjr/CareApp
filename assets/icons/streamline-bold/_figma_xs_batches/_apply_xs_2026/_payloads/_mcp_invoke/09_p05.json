{"fileKey": "hB1NzwMnZt2ALeR0OslaWi", "skillNames": "figma-use,figma-generate-library", "description": "Apply bold xs batch 09", "code": "\nconst page = await figma.getNodeByIdAsync('9:13081');\nawait figma.setCurrentPageAsync(page);\nconst colorVar = await figma.variables.getVariableByIdAsync('VariableID:34:2');\nconst FILL = { r: 0.062745, g: 0.094118, b: 0.156863 };\nfunction paint(node) {\n  node.fills = [figma.variables.setBoundVariableForPaint({ type: 'SOLID', color: FILL }, 'color', colorVar)];\n  node.strokes = [];\n}\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') paint(n);\n    if ('clipsContent' in n && n.type === 'FRAME') n.clipsContent = false;\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop() + ' · bold';\n  try { node.resize(16, 16); } catch (e) {}\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  bindFills(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (e) { try { xs.resize(16, 16); } catch (e2) {} }\n  xs.clipsContent = false;\n  xs.visible = true;\n  for (const v of set.children) v.visible = true;\n  set.clipsContent = true;\n  set.counterAxisAlignItems = 'MIN';\n  set.primaryAxisAlignItems = 'MIN';\n  if (set.layoutMode !== 'NONE') {\n    set.primaryAxisSizingMode = 'FIXED';\n    set.counterAxisSizingMode = 'FIXED';\n  }\n  set.resize(16, 16);\n  try { set.layoutSizingHorizontal = 'FIXED'; set.layoutSizingVertical = 'FIXED'; } catch (e) {}\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/actions/new\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"New-Spreadsheet--Streamline-Ultimate\\\"> <path fill=\\\"#000000\\\" fill-rule=\\\"evenodd\\\" d=\\\"M4.58714 0.0993652c0.55229 0 1 0.4477148 1 1.0000048v0.89431c0 0.55228 -0.44771 1 -1 1 -0.55228 0 -1 -0.44772 -1 -1v-0.89431c0 -0.55229 0.44772 -1.0000048 1 -1.0000048M10.4671 5.65332c0 -0.55228 0.4477 -1 1 -1h9.4957c1.6182 0 2.9379 1.31977 2.9379 2.93791V20.9627c0 1.6181 -1.3197 2.9379 -2.9379 2.9379H3.03719c-1.61813 0 -2.9379011 -1.3198 -2.9379011 -2.9379V11.467c0 -0.5523 0.4477151 -1 1.0000011 -1 0.55228 0 1 0.4477 1 1v4.8137h5.26714V11.467c0 -0.5523 0.44772 -1 1 -1l13.53427 0V7.59123c0 -0.51357 -0.4243 -0.93791 -0.9379 -0.93791h-9.4957c-0.5523 0 -1 -0.44771 -1 -1M21.9007 12.467l-5.2671 0v3.8137h5.2671zm0 5.8137h-5.2671v3.6199h4.3292c0.5136 0 0.9379 -0.4243 0.9379 -0.9379zm-7.2671 3.6199v-3.6199H9.36644v3.6199zm-7.26717 0v-3.6199H2.09929v2.682c0 0.5136 0.42434 0.9379 0.9379 0.9379zm2.00001 -5.6199h5.26716V12.467H9.36644zM1.62928 2.30826c-0.46833 -0.29271 -1.085284 -0.15033 -1.377994 0.318 -0.2927092 0.46834 -0.150335 1.08529 0.318002 1.378l0.715452 0.44716c0.46834 0.29271 1.08529 0.15033 1.378 -0.318 0.29271 -0.46834 0.15033 -1.08529 -0.318 -1.378zm1.03346 3.89515c0.29271 0.46834 0.15033 1.08529 -0.318 1.378l-0.71546 0.44716c-0.46833 0.29271 -1.085284 0.15033 -1.377994 -0.31801 -0.2927092 -0.46833 -0.150335 -1.08528 0.318002 -1.37799l0.715452 -0.44716c0.46834 -0.29271 1.08529 -0.15033 1.378 0.318m2.9244 2.05037c0 -0.55228 -0.44771 -1 -1 -1 -0.55228 0 -1 0.44772 -1 1v0.89432c0 0.55228 0.44772 1 1 1 0.55229 0 1 -0.44772 1 -1zm0.80877 -2.00596c0.26821 -0.48279 0.87701 -0.65673 1.3598 -0.38852l0.80488 0.44716c0.48278 0.26821 0.65673 0.87701 0.38852 1.3598 -0.26822 0.48278 