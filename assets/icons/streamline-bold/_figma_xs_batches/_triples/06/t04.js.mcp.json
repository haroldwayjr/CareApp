{"fileKey":"hB1NzwMnZt2ALeR0OslaWi","code":"\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\":\"icon/health/waiting.room\",\"name\":\"waiting-room\",\"category\":\"health\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Waiting-Room-Lamp--Streamline-Ultimate\\\">\\n  <desc>\\n    Waiting Room Lamp Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <g>\\n    <path d=\\\"M5 7.5a2.5 2.5 0 1 0 5 0 2.5 2.5 0 1 0 -5 0\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M13.24 17h-2.89a0.5 0.5 0 0 1 -0.5 -0.46c0 -0.05 -0.37 -3.31 -0.37 -3.31a1.5 1.5 0 0 0 -3 0.54l0.35 3.09A3.52 3.52 0 0 0 10.35 20h2.89a1.5 1.5 0 0 1 1.49 1.38l0.27 2.17a0.52 0.52 0 0 0 0.5 0.45h2a0.5 0.5 0 0 0 0.37 -0.17 0.52 0.52 0 0 0 0.13 -0.38l-0.24 -2.32A4.52 4.52 0 0 0 13.24 17\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M12.5 21.5H8.75a3.52 3.52 0 0 1 -3.43 -2.76l-0.68 -4a1.5 1.5 0 0 0 -1.48 -1.24H1.5a0.5 0.5 0 0 0 -0.5 0.5v9.5a0.5 0.5 0 0 0 0.5 0.5h11.19a0.48 0.48 0 0 0 0.37 -0.17 0.47 0.47 0 0 0 0.12 -0.39l-0.18 -1.5a0.51 0.51 0 0 0 -0.5 -0.44\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M20 3.14V1a1 1 0 0 0 -2 0v2.14A4 4 0 0 0 15 7v0.5a1 1 0 0 0 1 1h6a1 1 0 0 0 1 -1V7a4 4 0 0 0 -3 -3.86\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n  </g>\\n</svg>\"},{\"setName\":\"icon/health/bed\",\"name\":\"bed\",\"category\":\"health\",\"svg\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Hospital-Bedroom--Streamline-Ultimate\\\">\\n  <desc>\\n    Hospital Bedroom Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <g>\\n    <path d=\\\"M3.5 15.25a2.5 2.5 0 1 0 5 0 2.5 2.5 0 1 0 -5 0\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n    <path d=\\\"M23 14.75a1 1 0 0 0 -1 1V19a0.25 0.25 0 0 1 -0.25 0.25H2.25A0.25 0.25 0 0 1 2 19v-5.75a1 1 0 0 0 -2 0V23a1 1 0 0 0 2 0v-0.5a0.25 0.25 0 0 1 0.25 -0.25h19.5a0.25 0.25 0 0 1 0.25 0.25v0.5a1 1 0 0 0 2 0v-7.25a1 1 0 0 0 -1 -1\\\" fill=