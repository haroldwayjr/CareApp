1 0.51 0 0 1 0 0.7l-1.21 1.21a0.5 0.5 0 0 1 -0.71 0l-1.06 -1.06 -1.06 -1.06a0.5 0.5 0 0 1 0 -0.71l1.21 -1.21a0.51 0.51 0 0 1 0.7 0Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> </svg>\"}, {\"setName\": \"icon/health/thermometer\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Temperature-Thermometer--Streamline-Ultimate\\\"> <g> <path d=\\\"M16.56 14.1a0.23 0.23 0 0 1 -0.06 -0.16V4.5a4.5 4.5 0 0 0 -9 0v9.44a0.23 0.23 0 0 1 -0.06 0.16 6 6 0 1 0 9.12 0M12 22a4 4 0 0 1 -2.8 -6.86 1 1 0 0 0 0.3 -0.71V4.5a2.5 2.5 0 0 1 5 0v9.93a1 1 0 0 0 0.3 0.71A4 4 0 0 1 12 22\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> <path d=\\\"M13.11 16.34a0.26 0.26 0 0 1 -0.11 -0.21V7a1 1 0 0 0 -2 0v9.13a0.26 0.26 0 0 1 -0.11 0.21 2 2 0 1 0 2.22 0\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path> </g> </svg>\"}];\nlet ok=0, missing=0, failed=0; const miss=[], fail=[];\nfor (const item of BATCH) {\n  const set = figma.currentPage.findOne(n => n.type === 'COMPONENT_SET' && n.name === item.setName);\n  if (!set) { missing++; if (miss.length<8) miss.push(item.setName); continue; }\n  try {\n    const r = applyBoldXs(set, item.svg);\n    if (r.ok) ok++; else { failed++; fail.push({name:item.setName,r}); }\n  } catch(e) { failed++; if (fail.length<8) fail.push({name:item.setName,err:String(e)}); }\n}\nreturn { ok, missing, failed, miss, fail };\n"}