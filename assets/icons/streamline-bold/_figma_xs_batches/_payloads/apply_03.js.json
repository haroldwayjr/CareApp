{"fileKey":"hB1NzwMnZt2ALeR0OslaWi","description":"Apply Streamline Bold SVGs to Size=xs (apply_03.js)","skillNames":"resource:figma-use","code":"\nconst page = figma.root.children.find(p => /Icons/i.test(p.name));\nawait figma.setCurrentPageAsync(page);\n\nconst collections = await figma.variables.getLocalVariableCollectionsAsync();\nlet iconDefault = null;\nfor (const coll of collections) {\n  for (const id of coll.variableIds) {\n    const v = await figma.variables.getVariableByIdAsync(id);\n    if (v && v.name === 'icon/default') iconDefault = v;\n  }\n}\n\nfunction bindFills(root) {\n  const stack = [root];\n  while (stack.length) {\n    const n = stack.pop();\n    if ('constraints' in n) n.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n    if (n.type === 'VECTOR' || n.type === 'BOOLEAN_OPERATION' || n.type === 'ELLIPSE' || n.type === 'STAR' || n.type === 'POLYGON') {\n      const paint = figma.variables.setBoundVariableForPaint(\n        { type: 'SOLID', color: { r: 0, g: 0, b: 0 } }, 'color', iconDefault);\n      n.fills = [paint];\n      n.strokes = [];\n    }\n    if ('children' in n) for (const c of n.children) stack.push(c);\n  }\n}\n\nfunction applyBoldXs(set, svg) {\n  const xs = set.children.find(c => c.name === 'Size=xs');\n  const md = set.children.find(c => c.name === 'Size=md');\n  if (!xs) return { ok: false, reason: 'no-xs' };\n  const was = xs.visible;\n  xs.visible = true;\n  for (const c of [...xs.children]) c.remove();\n  const node = figma.createNodeFromSvg(svg);\n  node.name = set.name.split('/').pop();\n  node.resize(16, 16);\n  node.x = 0; node.y = 0;\n  node.clipsContent = false;\n  if ('constraints' in node) node.constraints = { horizontal: 'SCALE', vertical: 'SCALE' };\n  xs.appendChild(node);\n  try { xs.resizeWithoutConstraints(16, 16); } catch (_) { try { xs.resize(16, 16); } catch (__) {} }\n  bindFills(node);\n  xs.clipsContent = false;\n  xs.visible = false; // keep catalog md-only\n  if (md) md.visible = true;\n  try { set.resizeWithoutConstraints(24, 24); } catch (_) {}\n  set.clipsContent = true;\n  return { ok: true };\n}\n\nconst BATCH = [{\"setName\": \"icon/actions/forward.alt\", \"name\": \"forward-alt\", \"category\": \"actions\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Button-Fast-Forward--Streamline-Ultimate\\\">\\n  <desc>\\n    Button Fast Forward Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path d=\\\"M12 24A12 12 0 1 0 0 12a12 12 0 0 0 12 12M7.54 9.79a0.78 0.78 0 0 1 0.36 -0.69 0.74 0.74 0 0 1 0.77 0l3 1.62a0.25 0.25 0 0 0 0.37 -0.22v-0.71a0.78 0.78 0 0 1 0.36 -0.69 0.74 0.74 0 0 1 0.77 0l5.09 2.73a0.76 0.76 0 0 1 0.43 0.66 0.74 0.74 0 0 1 -0.43 0.65l-5.09 2.74a0.74 0.74 0 0 1 -1.13 -0.68v-0.72a0.27 0.27 0 0 0 -0.12 -0.22 0.25 0.25 0 0 0 -0.25 0l-3 1.62a0.87 0.87 0 0 1 -0.41 0.11 0.65 0.65 0 0 1 -0.36 -0.1 0.78 0.78 0 0 1 -0.36 -0.69Z\\\" fill=\\\"#000000\\\" stroke-width=\\\"1\\\"></path>\\n</svg>\"}, {\"setName\": \"icon/actions/reply.alt\", \"name\": \"reply-alt\", \"category\": \"actions\", \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" id=\\\"Reply-To-Message--Streamline-Ultimate\\\">\\n  <desc>\\n    Reply To Message Streamline Icon: https://streamlinehq.com\\n  </desc>\\n  <path fill=\\\"#000000\\\" fill-rule=\\\"evenodd\\\" d=\\\"M13.293 0.273a0.75 0.75 0 0 1 0.463 0.693v1.459h6.632a2.915 2.915 0 0 1 2.915 2.915v11.861a2.915 2.915 0 0 1 -2.915 2.916h-8.595l-4.802 3.317c-1.299 0.898 -3.07 -0.032 -3.07 -1.61v-1.707h-0.308a2.915 2.915 0 0 1 -2.916 -2.916V5.341a2.915 2.915 0 0 1 2.916 -2.916h2.146a1 1 0 1 1 0 2H3.613a0.915 0.915 0 0 0 -0.916 0.915v11.861c0 0.506 0.41 0.916 0.916 0.916H4.92a1 1 0 0 1 1 1v2.626l4.993 -3.449a1 1 0 0 1 0.568 -0.177h8.907c0.506 0 0.915 -0.41 0.915 -0.916V5.341a0.915 0.915 0 0 0 -0.915 -0.916h-6.632v1.458a0.75 0.75 0 0 1 -1.28 0.53l-2.459 -2.458a0.75 0.75 0 0 1 0 -1.061L12.476 0.436a0.75 0.75 0 0 1 0.817 -0.163m-0.03